@'
# ---------- Global ----------
.DS_Store
Thumbs.db
*.log
*.swp
*.tmp

# ---------- Variables de entorno ----------
.env
!.env.example

# ---------- IDEs ----------
.idea/
.vscode/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/

